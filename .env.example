# AmneziaWG 2 VPN Service — конфигурация
# Скопируйте в .env: cp .env.example .env

# ── Amnezia Web Panel (PRVTPRO) ───────────────────────────────────────────────

# Порт веб-панели
APP_PORT=5000

# Docker-образ панели
PANEL_IMAGE=prvtpro/amnezia-panel:1.4.4

# Секретный ключ сессий (генерируется автоматически при установке)
SECRET_KEY=

# Логин/пароль панели (по умолчанию admin/admin — смените после входа!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── SSH-доступ панели к серверу ───────────────────────────────────────────────
# Панель управляет VPN через SSH. На том же сервере используйте 127.0.0.1

SSH_HOST=127.0.0.1
SSH_USER=root
SSH_PORT=22
SSH_PASSWORD=
# SSH_PRIVATE_KEY=   # альтернатива паролю (содержимое ключа)

# Имя сервера в панели
SERVER_NAME=Local VPN

# ── AmneziaWG 2.0 ───────────────────────────────────────────────────────────

# UDP-порт VPN
AWG2_PORT=51820

# Протокол для скриптов управления клиентами
AWG_PROTOCOL=awg2

# ID сервера в панели (обычно 0 для первого)
SERVER_ID=0

# Автоматически установить AWG2 через API панели (y/n)
BOOTSTRAP_AWG=y

# ── Reverse proxy (Caddy) ─────────────────────────────────────────────────────

INSTALL_CADDY=n
ADMIN_DOMAIN=vpn-admin.example.com
CADDY_EMAIL=admin@example.com
ADMIN_ALLOWED_IPS=

# ── Установка ─────────────────────────────────────────────────────────────────

AUTO_INSTALL=n
