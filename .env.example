# AmneziaWG 2 VPN Service — конфигурация
# Скопируйте в .env и отредактируйте перед установкой:
#   cp .env.example .env

# ── VPN сервер (AmneziaWG 2.0) ──────────────────────────────────────────────

# Публичный IP сервера (автоопределение, если пусто)
SERVER_PUB_IP=

# UDP-порт VPN (по умолчанию случайный 49152–65535)
SERVER_PORT=51820

# Сеть VPN
SERVER_AWG_IPV4=10.66.66.1
SERVER_AWG_IPV6=fd42:42:42::1
ENABLE_IPV6=y

# DNS для клиентов
CLIENT_DNS_1=1.1.1.1
CLIENT_DNS_2=1.0.0.1

# Маршруты клиентов (0.0.0.0/0 = весь трафик через VPN)
ALLOWED_IPS=0.0.0.0/0,::/0

# ── Веб-админка ─────────────────────────────────────────────────────────────

# Логин администратора
ADMIN_USERNAME=admin

# Пароль администратора (используется при установке, не хранится в файле)
ADMIN_PASSWORD=

# Адрес прослушивания панели (127.0.0.1 — только локально, безопаснее)
AWG_WEB_HOST=127.0.0.1
AWG_WEB_PORT=8080

# Интервал опроса статистики (секунды)
AWG_POLL_INTERVAL=30

# Время жизни сессии (секунды, 86400 = 24 часа)
AUTH_SESSION_TTL_SECS=86400

# ── Reverse proxy (Caddy) ───────────────────────────────────────────────────

# Установить Caddy для HTTPS-доступа к админке
INSTALL_CADDY=n

# Домен для админки (обязателен, если INSTALL_CADDY=y)
ADMIN_DOMAIN=vpn-admin.example.com

# Email для Let's Encrypt
CADDY_EMAIL=admin@example.com

# Разрешённые IP для доступа к админке (через запятую, пусто = все)
# Пример: 10.0.0.0/8,192.168.0.0/16
ADMIN_ALLOWED_IPS=

# ── Установка ───────────────────────────────────────────────────────────────

# Неинтерактивный режим (y/n)
AUTO_INSTALL=n

# Версия репозитория amneziawg-install
AMNEZIAWG_REPO_REF=main
